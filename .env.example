# Adresse et clé publique de votre projet Supabase (Supabase > Project Settings > API).
# Sans ces deux variables, l'application démarre en mode démonstration (données dans le navigateur).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique

# Adresse affichée dans les pages Confidentialité et Conditions (facultatif mais conseillé)
VITE_CONTACT_EMAIL=contact@exemple.com
